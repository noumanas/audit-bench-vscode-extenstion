{
  "name": "auditbench-vscode",
  "displayName": "Audit Bench Ai",
  "description": "AI code review, security, logic, performance, architecture, and test-coverage findings — right in the editor.",
  "version": "0.1.0",
  "publisher": "auditbench",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/noumanas/audit-bench-vscode-extenstion.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auditbench.auditCurrentFile",
        "title": "Audit Bench Ai: Audit Current File",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "auditbench.fixAllWithAi",
        "title": "Audit Bench Ai: Fix All Issues with AI",
        "icon": "$(wand)"
      },
      {
        "command": "auditbench.setApiKey",
        "title": "Audit Bench Ai: Set API Key"
      },
      {
        "command": "auditbench.clearFindings",
        "title": "Audit Bench Ai: Clear Findings for This File"
      },
      {
        "command": "auditbench.showAccount",
        "title": "Audit Bench Ai: Show Account & Usage"
      },
      {
        "command": "auditbench.showLogs",
        "title": "Audit Bench Ai: Show Logs"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "auditbench.auditCurrentFile",
          "group": "navigation"
        },
        {
          "command": "auditbench.fixAllWithAi",
          "group": "navigation",
          "when": "auditbench.hasFindings"
        }
      ],
      "editor/title": [
        {
          "command": "auditbench.fixAllWithAi",
          "group": "navigation",
          "when": "auditbench.hasFindings"
        }
      ]
    },
    "configuration": {
      "title": "Audit Bench Ai",
      "properties": {
        "auditbench.apiUrl": {
          "type": "string",
          "default": "https://audit-bench-backend-git-242355763105.europe-west1.run.app",
          "description": "Audit Bench Ai API base URL. Point this at http://localhost:4000 for local backend testing."
        },
        "auditbench.provider": {
          "type": "string",
          "enum": [
            "",
            "anthropic",
            "openai",
            "gemini",
            "deepseek",
            "glm",
            "qwen",
            "kimi",
            "xai",
            "mistral",
            "minimax"
          ],
          "default": "",
          "description": "LLM provider to use. Leave blank to use your account's default."
        },
        "auditbench.auditOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically audit a file every time you save it. Off by default — audits consume plan quota, so this is opt-in."
        },
        "auditbench.warnAboveChars": {
          "type": "number",
          "default": 20000,
          "description": "Ask for confirmation before auditing a file larger than this many characters — its full contents are sent to your configured LLM provider. Set to 0 to disable the prompt."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test dist/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.12.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
